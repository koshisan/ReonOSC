[Unit]
Description=Heated socks BLE <-> MQTT bridge (ReonOSC)
After=bluetooth.service network-online.target
Wants=bluetooth.service network-online.target

[Service]
ExecStart=/opt/sockbridge/venv/bin/python -u /opt/sockbridge/sockbridge.py /opt/sockbridge/config.json
Restart=always
RestartSec=5
# Gives the bridge time to switch the socks off on stop.
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
